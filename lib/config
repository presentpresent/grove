#!/bin/bash
# grove 공통 설정 — 모든 lib/* 가 맨 위에서 source 함
#
# 값은 세 곳에서 옴. 아래로 갈수록 우선순위가 높음:
#   1) 여기 기본값
#   2) ~/.config/grove/config  (있으면)
#   3) 환경변수 GROVE_*
#
# 남에게 줄 때 손댈 곳은 ~/.config/grove/config 하나뿐임.
#
# ⚠️ 사용자 설정을 **기본값보다 먼저** 읽음. 순서를 뒤집으면 기본값이 이미 채워져서
#    사용자 설정의 "환경변수가 없을 때만" 가드가 영영 안 걸림
[ -f "$HOME/.config/grove/config" ] && . "$HOME/.config/grove/config"

# ── 경로 ──
: "${GROVE_ROOT:=$HOME/Projects}"          # 워크스페이스 루트
: "${GROVE_TREES:=$GROVE_ROOT/worktrees}"  # 작업별 워크트리
: "${GROVE_ARCHIVE:=$GROVE_ROOT/archive}"  # 끝난 작업 보관

# 레포 원본 (읽기 전용). 콜론으로 여러 경로를 줄 수 있음:
#   GROVE_REPOS="$HOME/Projects/repos:$HOME/dev:$HOME/work/oss"
# 앞에 적은 경로가 먼저 검색됨. 없는 경로는 조용히 건너뜀
: "${GROVE_REPOS:=$GROVE_ROOT/repos}"

# ── 브랜치 이름 ──
# {type} = 작업 종류, {name} = 작업명. prefix 만이 아니라 통째로 템플릿이라
# "{user}/{name}" · "{ticket}-{name}" 같은 전략도 담김
#
# ⚠️ `: "${VAR:=...{name}}"` 형태로 쓰면 안 됨 — 값 안의 `}` 가 파라미터 확장을
#    먼저 닫아서 GROVE_BRANCH 가 "feature/ACME-{name" 이 됨. 아래처럼 분리해서 대입할 것
[ -n "${GROVE_BRANCH:-}" ] || GROVE_BRANCH='{type}/{name}'

: "${GROVE_TYPE:=feature}"   # --type 을 안 주면 이것
: "${GROVE_TYPES:=feature,hotfix,fix,chore,docs,refactor,test,infra}"

# ── 회고 casebook (선택) ──
# 비우면 export 기능이 통째로 꺼짐. 개인 기록 레포를 쓰는 사람만 채우면 됨
# `:=` 가 아니라 `=` — 사용자가 "안 씀"으로 빈 값을 넣었으면 그대로 둬야 함
: "${GROVE_CASEBOOK=$HOME/wlog/cases}"

# ── 화면 (선택) ──
# herdr 가 없으면 `grove open` 이 안내만 하고 끝남. 여기도 빈 값을 살림
: "${GROVE_MUX=herdr}"

# ── 출력 언어 ──
# en | ko | auto. auto 는 LANG·LC_ALL 을 보고 정하며, 안 잡히면 en
: "${GROVE_LANG=auto}"

# ── 헬퍼 ──

# 한국어로 낼지. 메시지는 카탈로그 없이 호출부에 영·한 쌍으로 둠 —
# 언어가 둘뿐이면 키를 관리하는 비용보다 두 문장이 붙어 있는 값이 큼
grove_is_ko() {
    case "$GROVE_LANG" in
        ko) return 0 ;;
        en) return 1 ;;
    esac
    case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
        ko*) return 0 ;;
        *)   return 1 ;;   # LANG 이 비어 있으면 영어
    esac
}

# say <영문> <한글>
say() { if grove_is_ko; then printf '%s\n' "$2"; else printf '%s\n' "$1"; fi; }

# sayf <영문 형식> <한글 형식> [인자…]
sayf() {
    local en="$1" ko="$2"; shift 2
    if grove_is_ko; then printf "$ko" "$@"; else printf "$en" "$@"; fi
}

# 레포 검색 경로를 한 줄에 하나씩. 존재하는 것만
grove_repo_paths() {
    local p rest="$GROVE_REPOS"
    while [ -n "$rest" ]; do
        p="${rest%%:*}"
        if [ "$p" = "$rest" ]; then rest=""; else rest="${rest#*:}"; fi
        [ -n "$p" ] || continue
        p="${p/#\~/$HOME}"
        [ -d "$p" ] && printf '%s\n' "$p"
    done
    return 0
}

# 레포 이름으로 경로를 찾음. 여러 곳에서 잡히면 전부 출력 (호출부가 head -1)
# 이름에 glob 을 써도 됨: grove_find_repo 'api-*'
# symlink 도 잡음 — 레포를 한 곳에 symlink 로 모아둔 사람이 있어서
grove_find_repo() {
    local name="$1" dir p
    grove_repo_paths | while IFS= read -r dir; do
        find "$dir" -maxdepth 1 -mindepth 1 -name "$name" \( -type d -o -type l \) 2>/dev/null
    done | while IFS= read -r p; do
        # git 레포만. repos/ 에 섞여 있는 AGENTS.md symlink·잡동사니 디렉토리를 걸러냄
        [ -e "$p/.git" ] && printf '%s\n' "$p"
    done
    return 0
}

# 작업 종류가 GROVE_TYPES 안에 있는지
grove_type_valid() {
    case ",$GROVE_TYPES," in
        *",$1,"*) return 0 ;;
    esac
    return 1
}

# 작업명을 브랜치 이름으로:  grove_branch <작업명> [종류]
grove_branch() {
    local name="$1" type="${2:-$GROVE_TYPE}" out="$GROVE_BRANCH"
    out="${out//\{type\}/$type}"
    out="${out//\{name\}/$name}"
    printf '%s' "$out"
}

# 회고 draft 맨 앞에 붙는 익명화 안내.
# rm 과 export 가 같은 걸 쓰므로 여기 하나만 둠 (전에는 양쪽에 복제돼 있었음)
#   grove_draft_header <draft 경로> <PLAN.md 경로>
grove_draft_header() {
    local draft="$1" plan="$2"
    echo "<!--"
    if grove_is_ko; then
        cat <<EOF
  ⚠️ 익명화 필요 — 지금 .draft.md 상태로는 push 안 됨 (.gitignore 차단)

  체크리스트:
  - [ ] 회사명/시스템명/레포명/사람 이름 → 일반화
  - [ ] 절댓값 매출/고객 수/고유 식별자 → 비율/범위
  - [ ] 회사 자산 코드 그대로 복사 X (개념적 재서술)
  - [ ] 파일명 자체에 회사 식별자 있으면 rename

  끝나면 (commit 가능 상태로):
    mv "$draft" "${draft%.draft.md}.md"
EOF
    else
        cat <<EOF
  ⚠️ Needs anonymising — a .draft.md cannot be pushed (.gitignore blocks it)

  Checklist:
  - [ ] company / system / repo / people names → generalise
  - [ ] absolute revenue, customer counts, unique ids → ratios or ranges
  - [ ] don't paste employer code verbatim — restate the idea
  - [ ] rename the file if the filename itself identifies the employer

  When done (ready to commit):
    mv "$draft" "${draft%.draft.md}.md"
EOF
    fi
    echo
    echo "  Source: $plan"
    echo "  Generated: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "-->"
}

# 옛 설정 호환: GROVE_BRANCH_HOTFIX 는 {type} 축으로 흡수됐음
# (say 를 쓰므로 헬퍼 정의 뒤에 있어야 함)
if [ -n "${GROVE_BRANCH_HOTFIX:-}" ]; then
    say "⚠️  GROVE_BRANCH_HOTFIX is gone. Put {type} in GROVE_BRANCH instead (e.g. '{type}/ACME-{name}')" \
        "⚠️  GROVE_BRANCH_HOTFIX 는 없어졌음. GROVE_BRANCH 에 {type} 을 쓸 것 (예: '{type}/ACME-{name}')" >&2
fi
