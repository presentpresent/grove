#!/bin/bash
# grove export <name>
# Generate anonymization draft for a worktree's PLAN.md.
# Useful when grove rm ran without auto-export, or to refresh a draft.
#
# Source priority:
#   1. $GROVE_ARCHIVE/<name>/PLAN.md  (already archived — most common)
#   2. $GROVE_TREES/<name>/PLAN.md    (still active)
#
# Output: $GROVE_CASEBOOK/<YYYY-Q[N]>-<name>.draft.md
#         (the .draft suffix keeps it out of git until anonymised)
. "$(cd "$(dirname "$0")" && pwd)/config"

set -euo pipefail

# 비어 있으면 회고 기능이 꺼진 것. dirname "" 는 "." 이라 존재 검사를 통과해버림
if [ -z "${GROVE_CASEBOOK:-}" ]; then
  say "Retrospectives are off — set GROVE_CASEBOOK to enable them." \
      "회고 기능이 꺼져 있음 — GROVE_CASEBOOK 을 채우면 켜짐" >&2
  exit 1
fi

WLOG_ROOT="$(dirname "$GROVE_CASEBOOK")"
WLOG_CASES="$GROVE_CASEBOOK"

usage() {
  cat <<EOF
Usage: grove export [--force] <name>

Generate an anonymisation draft in $GROVE_CASEBOOK from a worktree's PLAN.md.

Source priority:
  1. $GROVE_ARCHIVE/<name>/PLAN.md  (already archived)
  2. $GROVE_TREES/<name>/PLAN.md    (still active)

Output: $GROVE_CASEBOOK/<YYYY-Q[N]>-<name>.draft.md
        The .draft suffix is there so your casebook's .gitignore blocks it
        until you have anonymised it and renamed .draft → .md

Options:
  --force    Overwrite existing draft if present
EOF
  exit 1
}

force=false
positional=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --force) force=true; shift ;;
    -h|--help) usage ;;
    -*) usage ;;
    *) positional+=("$1"); shift ;;
  esac
done
set -- "${positional[@]+"${positional[@]}"}"

[[ $# -ne 1 ]] && usage

name="$1"

# Find PLAN.md (archive preferred, then active worktree)
plan_file=""
for candidate in "$GROVE_ARCHIVE/$name/PLAN.md" "$GROVE_TREES/$name/PLAN.md"; do
  if [[ -f "$candidate" ]]; then
    plan_file="$candidate"
    break
  fi
done

if [[ -z "$plan_file" ]]; then
  echo "Error: PLAN.md not found for '$name'"
  echo "  Looked in:"
  echo "    $GROVE_ARCHIVE/$name/PLAN.md"
  echo "    $GROVE_TREES/$name/PLAN.md"
  exit 1
fi

# Verify the casebook directory exists
if [[ ! -d "$WLOG_ROOT" ]]; then
  sayf "Error: %s not found. Create it, or point GROVE_CASEBOOK somewhere else.\n" "오류: %s 가 없음. 만들거나 GROVE_CASEBOOK 을 다른 곳으로 돌릴 것\n" "$WLOG_ROOT" >&2
  exit 1
fi

mkdir -p "$WLOG_CASES"

# Quarter from current date (YYYY-Q[1-4])
year=$(date +%Y)
month_num=$((10#$(date +%m)))
quarter=$(( (month_num - 1) / 3 + 1 ))

draft_file="$WLOG_CASES/${year}-Q${quarter}-${name}.draft.md"

if [[ -f "$draft_file" && "$force" == false ]]; then
  sayf "Error: %s already exists. Use --force to overwrite.\n" "오류: %s 가 이미 있음. 덮어쓰려면 --force\n" "$draft_file" >&2
  exit 1
fi

{
  grove_draft_header "$draft_file" "$plan_file"
  echo ""
  cat "$plan_file"
} > "$draft_file"

sayf "📝 Draft created: %s\n" "📝 회고 draft 생성됨: %s\n" "$draft_file"
say  "   Next: anonymise it, drop the .draft suffix, then commit" \
     "   다음: 익명화 → .draft 접미사 떼고 commit"
