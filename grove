#!/bin/bash
# grove — plant several repos in one worktree
#
# 사용자 진입점. 구현은 lib/ 안에 있음
# help 문구는 usage() 안에 영·한으로 같이 둠 (주석에서 뽑아 쓰면 한 언어밖에 못 냄)

set -euo pipefail

# npm 전역 설치는 /opt/homebrew/bin/grove 를 패키지 안으로 향하는 symlink 로 만듦.
# $0 를 그대로 dirname 하면 거기엔 lib/ 가 없음 → 링크를 끝까지 따라가서 기준을 잡음
SELF="$0"
while [ -L "$SELF" ]; do
    target="$(readlink "$SELF")"
    case "$target" in
        /*) SELF="$target" ;;
        *)  SELF="$(cd "$(dirname "$SELF")" && pwd)/$target" ;;
    esac
done
LIB="$(cd "$(dirname "$SELF")" && pwd)/lib"
. "$LIB/config"

usage() {
    if grove_is_ko; then
        cat <<EOF
grove — 한 작업에 여러 레포를 모아 심는 자리

  grove new  [--type <종류>] [--base <브랜치>] <작업명> <repo>…  워크트리 생성
  grove add  [--base <브랜치>] <작업명> <repo>…                  기존 워크트리에 레포 추가
  grove open <작업명> [--exec] [--no-plan]                       화면 열기
  grove ls   [--all]                                             활성 워크트리 조회
  grove rm   <작업명> [옵션]                                     아카이브 + 제거
  grove export <작업명>                                          회고 draft 사후 생성
  grove init [--dry-run] [--yes]                                 이 머신에 맞춰 설정 생성
  grove tell <작업명> [메시지]                                   레포 세션 전부에 통지
  grove ask  <질문>                                              계획 세션에 확인 요청

브랜치 이름은 GROVE_BRANCH 템플릿을 따름 (현재 $GROVE_BRANCH).
--hotfix 는 --type hotfix 축약. 경로·레포 검색 경로·casebook 도 설정에서 바꿈.

각 서브커맨드의 상세 옵션: grove <서브커맨드> --help
EOF
    else
        cat <<EOF
grove — plant several repos in one worktree

  grove new  [--type <type>] [--base <branch>] <name> <repo>…  create worktrees
  grove add  [--base <branch>] <name> <repo>…                  add a repo to existing work
  grove open <name> [--exec] [--no-plan]                       lay out the screen
  grove ls   [--all]                                           list active worktrees
  grove rm   <name> [options]                                  archive and remove
  grove export <name>                                          write a retrospective draft
  grove init [--dry-run] [--yes]                               detect this machine, write config
  grove tell <name> [message]                                  notify every repo session
  grove ask  <question>                                        raise a question to the plan session

Branch names follow the GROVE_BRANCH template (currently $GROVE_BRANCH).
--hotfix is short for --type hotfix. Paths, repo search paths and casebook
live in the same config.

Per-command options: grove <command> --help
EOF
    fi
    exit "${1:-1}"
}

[ $# -gt 0 ] || usage 1
cmd="$1"; shift

case "$cmd" in
    new)
        # --hotfix 를 --type hotfix 로 번역. 나머지는 그대로 넘김
        args=()
        for a in "$@"; do
            case "$a" in
                --hotfix) args+=(--type hotfix) ;;
                *)        args+=("$a") ;;
            esac
        done
        exec "$LIB/new" "${args[@]+"${args[@]}"}"
        ;;

    add)     exec "$LIB/add" "$@" ;;

    open)
        # --exec 를 lib/open 의 --phase exec 로 번역
        args=()
        for a in "$@"; do
            case "$a" in
                --exec) args+=(--phase exec) ;;
                *)      args+=("$a") ;;
            esac
        done
        exec "$LIB/open" "${args[@]}"
        ;;

    # 셸 완성이 후보를 물어볼 때 씀. 사람이 칠 일은 없음
    types)   printf '%s\n' ${GROVE_TYPES//,/ } ;;
    repos)   grove_find_repo '*' | while IFS= read -r p; do basename "$p"; done | sort -u ;;
    paths)   case "${1:-}" in
                 root)    printf '%s\n' "$GROVE_ROOT" ;;
                 trees)   printf '%s\n' "$GROVE_TREES" ;;
                 archive) printf '%s\n' "$GROVE_ARCHIVE" ;;
                 repos)   grove_repo_paths ;;
                 *)       printf 'root=%s\ntrees=%s\narchive=%s\n' "$GROVE_ROOT" "$GROVE_TREES" "$GROVE_ARCHIVE" ;;
             esac ;;

    ls|list) exec "$LIB/list" "$@" ;;
    rm)      exec "$LIB/rm" "$@" ;;
    export)  exec "$LIB/export" "$@" ;;
    init)    exec "$LIB/init" "$@" ;;
    tell)    exec "$LIB/tell" "$@" ;;
    ask)     exec "$LIB/ask" "$@" ;;

    -h|--help|help) usage 0 ;;
    *) sayf "Unknown command: %s\n" "모르는 서브커맨드: %s\n" "$cmd" >&2; echo; usage 1 ;;
esac
